# Copy this file to .env.local. Do not commit .env.local.
RUNTIME_MODE=local
APP_HOST=127.0.0.1
PORT=8080
DATA_ROOT=D:\StudyMedData
MONGODB_URI=mongodb://127.0.0.1:27017/studymed_p015
GEMINI_API_KEYS=replace_with_key_1,replace_with_key_2
GEMINI_PROJECT_IDS=project_01,project_02
GEMINI_SCHEDULER_MODE=project_pool
GEMINI_ELIGIBLE_PROJECT_LIMIT=2
GEMINI_PROJECT_GROUP_SIZE=2
GEMINI_INITIAL_CONCURRENCY=2
GEMINI_MAX_CONCURRENCY=2
GEMINI_PROJECT_RPM=15
GEMINI_PROJECT_TPM=250000
GEMINI_PROJECT_RPD=500
GEMINI_PROJECT_HEADROOM=0.9
GEMINI_PROJECT_MAX_IN_FLIGHT=2
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=180000
TRANSLATION_PIPELINE_MODE=quality
PDF_PAGES_PER_CHUNK=2
GEMINI_THINKING_LEVEL=HIGH
QUALITY_MAX_REPAIR_CYCLES=2
# Match the former backend server execution profile.
TRANSLATION_WORKER_CONCURRENCY=3
PARALLEL_SOURCE_BUDGET_MB=15
MAX_FILE_SIZE_MB=159
MAX_JOB_ATTEMPTS=3
# Random local-only value used by Stop-StudyMedLocal.ps1. Never put it in a shortcut.
MAINTENANCE_CONTROL_TOKEN=replace_with_a_long_random_local_secret
LOCAL_DISK_RESERVE_MB=10240
LOCAL_RESOURCE_CPU_PAUSE_PERCENT=90
LOCAL_RESOURCE_CPU_RESUME_PERCENT=75
